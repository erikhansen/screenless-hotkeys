						<key>MacroActionType</key>
						<string>ExecuteAppleScript</string>
						<key>Path</key>
						<string></string>
						<key>Text</key>
						<string>-- Put keyboard focus on Word's Recent documents list. Word finishes setting
-- up this window after it appears and can move focus away again, so keep
-- checking for a few seconds until the list really has focus.
set winName to "Open new and recent files"
tell application "System Events" to tell process "Microsoft Word"
	repeat 50 times
		if exists window winName then exit repeat
		delay 0.1
	end repeat
	if not (exists window winName) then return "no window"
	delay 0.5
	repeat 20 times
		try
			set frontmost to true
			set w to window winName
			perform action "AXRaise" of w
			-- Show every recent document, not just favorites.
			set allTab to radio button "All" of radio group 1 of w
			if (value of allTab as text) is not "1" then
				click allTab
				delay 0.3
			end if
			set t to table 1 of scroll area 1 of group 1 of w
			set focused of t to true
			if (count of (rows of t whose selected is true)) = 0 then set selected of row 1 of t to true
			delay 0.2
			set f to value of attribute "AXFocusedUIElement"
			if (description of f as text) is "Recent documents" and (value of allTab as text) is "1" then return "focused"
		end try
		delay 0.2
	end repeat
	return "could not focus"
end tell
</string>
						<key>TimeOutAbortsMacro</key>
						<true/>
						<key>TrimResults</key>
						<true/>
						<key>TrimResultsNew</key>
						<true/>
						<key>UseText</key>
						<true/>
					</dict>
