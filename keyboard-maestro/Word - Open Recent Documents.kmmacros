						<key>MacroActionType</key>
						<string>SpeakText</string>
						<key>Text</key>
						<string>Recent documents.</string>
						<key>TimeOutAbortsMacro</key>
						<true/>
						<key>Voice</key>
						<string></string>
					</dict>
				</array>
